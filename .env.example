# URL pública definitiva (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.laboticadeale.es

# Google Analytics 4 (solo se carga si el visitante acepta cookies analíticas)
NEXT_PUBLIC_GA_ID=

# Verificación de Google Search Console (contenido de la meta "google-site-verification")
NEXT_PUBLIC_GSC_VERIFICATION=

# Envío de formularios por email con Resend (https://resend.com)
# Si no se configuran, los formularios informan al usuario y ofrecen llamar o TheFork.
RESEND_API_KEY=
FORM_TO_EMAIL=
FORM_FROM_EMAIL="La Botica de Ale <web@laboticadeale.es>"
